# Local development environment values. Copy to .env.local and fill in.
# Never commit real secrets.

# PostgreSQL connection string used by Drizzle ORM.
DATABASE_URL=

# Clerk authentication. Add secrets in .env.local; never commit them.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_INITIAL_ADMIN_EMAILS=
