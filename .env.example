# Local development environment values. Copy to .env.local and fill in.
# Never commit real secrets.

# PostgreSQL connection string used by Drizzle ORM.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sabkacollege"

# Auth secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"

# Base URL used for auth callbacks and links.
BETTER_AUTH_URL="http://localhost:3000"
